rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Archivos e imágenes aislados estrictamente por el UID del usuario
    match /archivos/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /imagenes/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
